@inherits LayoutComponentBase
@implements IDisposable
@inject GpsTimeService Gps
@inject WakeLockService WakeLock
@inject LocalStorageService Storage
@inject IJSRuntime JS

<div class="app">

    @if (updateAvailable)
    {
        <div class="update-banner" role="status" aria-live="polite">
            <span>A new version is available.</span>
            <button class="update-btn" @onclick="ApplyUpdate">Update now</button>
        </div>
    }

    <header class="topbar">
        <div class="brand">
            <span class="flag">🏁</span>
            <span class="brand-name">Rally Helper</span>
        </div>
        <div class="topbar-actions">
            <button class="wakelock-btn @(wakeLockOn ? "on" : null)" @onclick="ToggleWakeLock"
                    disabled="@(!wakeLockSupported)"
                    title="@(wakeLockSupported ? (wakeLockOn ? "Screen stays on (tap to disable)" : "Keep screen on") : "Screen wake lock not supported on this device")">
                ☀️
            </button>
            <div class="gps">
                <div class="gps-clock" title="GPS-corrected time">@Gps.CorrectedNow.ToString("HH:mm:ss")</div>
                <div class="gps-status @StatusClass()">
                    <span class="gps-dot"></span>
                    <span class="gps-text">@StatusText()</span>
                </div>
            </div>
        </div>
    </header>

    <aside class="sidebar">
        <nav class="navlinks">
            <NavLink class="navlink" href="" Match="NavLinkMatch.All">
                <span class="ico">🏁</span><span class="label">Dashboard</span>
            </NavLink>
            <NavLink class="navlink" href="calcnote">
                <span class="ico">🧮</span><span class="label">CalcNote</span>
            </NavLink>
            <NavLink class="navlink" href="circuit">
                <span class="ico">⏱</span><span class="label">Circuit</span>
            </NavLink>
        </nav>
    </aside>

    <main class="content">
        <div class="page">
            @Body
        </div>
        <footer class="foot">Rally Helper · remake of the VB6 original by SpeedsterK · GPS-corrected clock</footer>
    </main>

</div>

@code {
    private System.Threading.Timer? _uiTimer;
    private IJSObjectReference? _pwaModule;
    private DotNetObjectReference<MainLayout>? _selfRef;
    private bool updateAvailable;
    private bool wakeLockOn;
    private bool wakeLockSupported;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Gps.StartAsync();
        _uiTimer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 0, 200);
        await RegisterUpdateCheck();
        await InitWakeLock();
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitWakeLock()
    {
        await WakeLock.InitAsync();
        wakeLockSupported = WakeLock.IsSupported;
        wakeLockOn = await Storage.GetBoolAsync("keepScreenOn", false) && wakeLockSupported;
        if (wakeLockOn)
            await WakeLock.SetEnabledAsync(true);
    }

    private async Task ToggleWakeLock()
    {
        wakeLockOn = !wakeLockOn;
        await WakeLock.SetEnabledAsync(wakeLockOn);
        await Storage.SetBoolAsync("keepScreenOn", wakeLockOn);
    }

    private async Task RegisterUpdateCheck()
    {
        try
        {
            _pwaModule = await JS.InvokeAsync<IJSObjectReference>("import", "./pwa-update.js");
            _selfRef = DotNetObjectReference.Create(this);
            await _pwaModule.InvokeVoidAsync("registerForUpdate", _selfRef);
        }
        catch
        {
            // update checks are best-effort; fail silently on unsupported browsers
        }
    }

    [JSInvokable]
    public void OnUpdateAvailable()
    {
        updateAvailable = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task ApplyUpdate()
    {
        try
        {
            if (_pwaModule is not null)
                await _pwaModule.InvokeVoidAsync("skipWaiting");
        }
        catch
        {
            // Fallback: hard reload if the SW message fails.
            await JS.InvokeVoidAsync("location.reload");
        }
    }

    public void Dispose()
    {
        _uiTimer?.Dispose();
        _selfRef?.Dispose();
    }

    private string StatusClass() => Gps.Status switch
    {
        GpsStatus.Good => "good",
        GpsStatus.Stale => "stale",
        GpsStatus.Denied or GpsStatus.Error or GpsStatus.Timeout => "bad",
        _ => "none"
    };

    private string StatusText()
    {
        return Gps.Status switch
        {
            GpsStatus.Good => $"GPS {Gps.LastAccuracy?.ToString("0.0") ?? "—"}m",
            GpsStatus.Stale => "GPS stale",
            GpsStatus.Denied => "GPS denied",
            GpsStatus.Error => Gps.ErrorMessage ?? "GPS error",
            GpsStatus.Timeout => "GPS timeout",
            _ => "GPS off"
        };
    }
}